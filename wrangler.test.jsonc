{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "data-relaton-org-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dumps-test",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "dumps-test" }],
  "vars": { "ADMIN_TOKEN": "test-admin" }
}
