{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "data-relaton-org",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "relaton-dumps"
    }
  ],
  "routes": [{ "pattern": "data.relaton.org", "custom_domain": true }]
}
